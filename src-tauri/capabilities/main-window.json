{
  "identifier": "main-window",
  "description": "Permissions for the BentoDesk main overlay window. Includes tray + updater + global-shortcut + dialog APIs that the settings UI exercises but minibar windows should never reach.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-cursor-position",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-outer-position",
    "core:window:allow-current-monitor",
    "core:tray:default",
    "updater:default",
    "global-shortcut:default",
    "dialog:allow-open"
  ]
}
